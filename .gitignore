*.o
*.ppu
/SJ3

# SDL2 Pascal headers, cloned locally (see README)
/Pascal-SDL-2-Headers/

# Generated at runtime
/SENDME.TXT

# Live player state, rewritten by the game every time it exits. Pristine copies
# live in defaults/ and are installed by build.sh when these are missing, so a
# fresh clone still starts (the game halts if any of them is absent).
/CONFIG.SKI
/HISCORE.SKI
/PLAYERS.SKI

# Regenerated at startup from the .SJH files present
/MOREHILL.SKI

# User-created hills, cups and replays (INTRO.SJR ships with the game)
*.SJH
*.SJC
*.SJR
!INTRO.SJR
